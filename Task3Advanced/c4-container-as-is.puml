@startuml C4 Container — as-is «Будущее 2.0»
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
title C4 Container — текущий ландшафт «Будущее 2.0»

Person(operator, "Оператор клиники", "Работает с картами, исследованиями и снимками")
Person(analyst, "Аналитик / сотрудник офиса", "Строит отчёты в Power BI")

System_Boundary(future, "Будущее 2.0 (as-is)") {
    Container(pb, "Клиентский интерфейс оператора", "PowerBuilder", "UI клиник. Бизнес-логика частично здесь, частично в DWH")
    ContainerDb(dwh, "DWH", "MS SQL Server 2008", "Единое хранилище: клиенты, карты, финансы, кадры, инвентарь, отчётность. Сотни ТБ, пакетные трансформации")
    Container(bi, "BI-система", "Power BI", "Кастомные отчёты поверх DWH. Сложные витрины считаются часами")
    Container(esb, "Сервисная шина (ESB)", "Apache Camel", "Синхронные и пакетные интеграции. Точка связности всех доменов")
    Container(ai, "ИИ-сервисы", "Python", "Диагностика и работа с медицинскими данными")
    Container(fin, "Финтех-сервисы", "Golang, Java", "Банковские продукты, счета, кредиты")
    Container(ops, "Внутренние сервисы", "разное", "Управление клиниками, внутренние финансы, кадры, инвентарь")
}

Rel(operator, pb, "Вводит и просматривает данные")
Rel(pb, dwh, "Пишет и читает", "медицинские данные, снимки")
Rel(analyst, bi, "Запрашивает отчёты")
Rel(dwh, bi, "Отдаёт витрины", "пакетно, SQL")
BiRel(dwh, esb, "Синхронизация мастер-данных и результатов")
BiRel(ai, esb, "Обмен", "медицинские данные")
BiRel(fin, esb, "Обмен", "финансовые данные")
BiRel(ops, esb, "Обмен", "внутренние финансы, управление клиниками")

SHOW_LEGEND()
@enduml
